# ============================================================
# VARIABLES D'ENVIRONNEMENT — copier ce fichier en .env
# et remplir les valeurs. Ne jamais committer .env !
# ============================================================

# Base de données
DB_URL=jdbc:mariadb://localhost:3306/freelance_db
DB_USERNAME=freelance_user
DB_PASSWORD=VotreMotDePasseDB_Ici

# JWT — générer avec : openssl rand -base64 64
JWT_SECRET=RemplacerParUnSecretAleatoireDe64CaracMinimum
JWT_EXPIRATION=86400000

# Email Gmail (utiliser un App Password, pas le vrai mot de passe)
MAIL_USERNAME=votre.email@gmail.com
MAIL_PASSWORD=votre_app_password_gmail

# URL du frontend
FRONTEND_URL=http://localhost:5173

# JPA (dev: update | prod: validate)
JPA_DDL_AUTO=update